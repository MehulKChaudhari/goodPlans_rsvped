{
  "name": "goodplans-rsvped",
  "version": "1.0.0",
  "private": true,
  "description": "Event Booking System backend — API for Organizers to manage events and Customers to book tickets.",
  "type": "commonjs",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker:start": "node dist/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "load:baseline": "tsx load-test/run.ts baseline",
    "load:optimized": "tsx load-test/run.ts optimized"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bcryptjs": "2.4.3",
    "bullmq": "5.12.0",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.0",
    "express-async-errors": "3.1.1",
    "express-rate-limit": "7.4.0",
    "express-validator": "7.2.0",
    "helmet": "7.1.0",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "pino": "9.4.0",
    "pino-http": "10.3.0",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@types/autocannon": "7.12.5",
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "4.19.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.16.5",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "autocannon": "7.15.0",
    "pino-pretty": "11.2.2",
    "prisma": "5.20.0",
    "railway": "^3.17.0",
    "supertest": "7.0.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "2.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
